# Radio Calico Docker Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=development
FLASK_APP=main.py
FLASK_DEBUG=1

# Production: Change this to a secure random value!
SECRET_KEY=dev-secret-change-in-prod

# ============================================================================
# Database Configuration
# ============================================================================
# For SQLite (development/small deployments):
DATABASE_URL=sqlite:///instance/radiocalico.db

# For production with PostgreSQL (requires additional setup):
# DATABASE_URL=postgresql://user:password@postgres:5432/radiocalico

# ============================================================================
# Application Configuration
# ============================================================================
# Node/Express configuration
NODE_ENV=development
PORT=3000

# Python runtime
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Compose project name (affects container naming)
COMPOSE_PROJECT_NAME=radiocalico

# ============================================================================
# Optional: Reverse Proxy Configuration (for production)
# ============================================================================
# If using nginx or other reverse proxy:
# PROXY_HOST=radiocalico.example.com
# PROXY_PORT=80
