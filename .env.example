# Radio Calico Docker Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=development
FLASK_APP=main.py
FLASK_DEBUG=1

# Production: Change this to a secure random value!
SECRET_KEY=dev-secret-change-in-prod

# ============================================================================
# Database Configuration
# ============================================================================
# For production with PostgreSQL (recommended):
DATABASE_URL=postgresql://radiocalico:password@postgres:5432/radiocalico

# For development with SQLite (alternative):
# DATABASE_URL=sqlite:///instance/radiocalico.db

# ============================================================================
# Application Configuration
# ============================================================================
# Python runtime
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Compose project name (affects container naming)
COMPOSE_PROJECT_NAME=radiocalico

# ============================================================================
# Optional: Reverse Proxy Configuration (for production)
# ============================================================================
# If using nginx or other reverse proxy:
# PROXY_HOST=radiocalico.example.com
# PROXY_PORT=80
